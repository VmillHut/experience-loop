{
  "description": "Opt-in, controls-aware Experience Loop routing.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "commandWindows": "py -3 -B -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'], 'hooks', 'session_start.py'), run_name='__main__')\"",
            "timeout": 3,
            "additionalContextLimit": 448
          }
        ]
      }
    ]
  }
}
